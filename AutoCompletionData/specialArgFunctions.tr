(* Matheme special argument completions.

   PacletInfo.m declares {"AutoCompletionData", Root -> "AutoCompletionData"},
   so the FrontEnd merges this file into its specialArgFunctions table.  See
   SystemFiles/Components/AutoCompletionData/Main/specialArgFunctions.tr for
   the format: each entry is "FunctionName" -> {argSpec1, argSpec2, ...},
   with ONE specifier per argument position.  0 means no special completion;
   a list of strings is a literal completion list (no .trie file needed, as
   in GraphStore/AutoCompletionData/specialArgFunctions.tr and WSM's).

   OptionsPattern[] functions follow NDSolve/FEM.m: one specifier per
   positional argument, then a single final specifier holding the option
   names.  Option values are NOT listed here -- the FrontEnd binds them to
   option names through its own OptionValues/<Function>.m data, and a
   special-arg specifier has no per-option slot.

   Keep the option-name lists in sync with Options[...] in Kernel/Matheme.wl
   and Kernel/TypstForm/Config.wl. *)

{
  (* source_String, opts : OptionsPattern[] *)
  "MathemeCompile" -> {
    0,
    {"Inputs", "BasePath", "AllowDownloads", "TypstTemplate", "Format",
     "Pages", "PDFStandard", "PDFTags", "CreationTimestamp", "Features",
     "Evaluate"}
  },
  "MathemeToGraphics" -> {
    0,
    {"Inputs", "BasePath", "AllowDownloads", "TypstTemplate", "Format",
     "Pages", "PDFStandard", "PDFTags", "CreationTimestamp", "Features",
     "Evaluate"}
  },
  "TypstForm" -> {
    0,
    {"Form", "ExpressionRules", "BoxRules", "TemplateRules", "CharacterRules",
     "OperatorNames", "DelimiterStyle", "FractionStyle", "ConstantStyle",
     "DifferentialStyle", "TransposeSymbol", "ConjugateStyle",
     "BlackboardStyle", "ScriptStyle", "MultiLetterStyle", "MatrixDelimiter",
     "PreserveStyle", "StripContext", "UnknownCharacterHandler",
     "UnsupportedBoxHandler"}
  },
  "MathemeToTypst" -> {
    0,
    {"Form", "ExpressionRules", "BoxRules", "TemplateRules", "CharacterRules",
     "OperatorNames", "DelimiterStyle", "FractionStyle", "ConstantStyle",
     "DifferentialStyle", "TransposeSymbol", "ConjugateStyle",
     "BlackboardStyle", "ScriptStyle", "MultiLetterStyle", "MatrixDelimiter",
     "PreserveStyle", "StripContext", "UnknownCharacterHandler",
     "UnsupportedBoxHandler"}
  },
  "BoxesToTypst" -> {
    0,
    {"BoxRules", "TemplateRules", "CharacterRules", "OperatorNames",
     "DelimiterStyle", "FractionStyle", "ConstantStyle", "DifferentialStyle",
     "TransposeSymbol", "ConjugateStyle", "BlackboardStyle", "ScriptStyle",
     "MultiLetterStyle", "MatrixDelimiter", "PreserveStyle", "StripContext",
     "UnknownCharacterHandler", "UnsupportedBoxHandler"}
  },

  (* opts : OptionsPattern[] only *)
  "MathemeWarmup" -> {{"Fonts", "Packages", "PackageIndex"}},
  "SetMatheme" -> {
    {"FontPaths", "SystemFonts", "EmbeddedFonts", "PackagePath",
     "PackageCache", "Proxy", "Downloads"}
  },

  (* one Association / rule argument, completed from its keys *)
  "MathemeQueryFonts" -> {
    {"Family", "Source", "Resident", "Character", "Offset", "MaxResults"}
  },
  "MathemeQueryPackages" -> {
    {"Name", "Namespace", "Version", "Origin", "Offset", "MaxResults",
     "AllowDownloads", "Refresh"}
  },
  "ClearMathemeCache" -> {
    {"Fonts", "Packages", "Memoization", "All"}
  }
}
