# Normalize line endings in the repository; check out as-is.
* text=auto

# Shell scripts must stay LF or Git Bash cannot execute them on Windows.
*.sh text eol=lf

# Source and config files: LF for cross-platform tooling consistency.
*.rs  text eol=lf
*.toml text eol=lf
*.wl  text eol=lf
*.m   text eol=lf
*.md  text eol=lf

# Binary artifacts: never apply line-ending conversion.
*.dll binary
*.pdb binary
*.lib binary
*.exp binary
*.pdf binary
*.png binary
