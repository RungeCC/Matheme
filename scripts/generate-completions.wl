(* ::Package:: *)

(* Generate specialArgFunctions.tr directly into the assembled paclet at
   output/Matheme/AutoCompletionData/ for the Wolfram FrontEnd.

   Run from the workspace root by scripts/build.nu, after cargo has built the
   library, regenerated Kernel/ArgumentTypes.wl, and created output/Matheme.
   No Wolfram source is parsed and no function or option name is duplicated
   here: the public function list comes from the loaded package, option names
   from Options[f] (Wolfram-defined) or the generated $argumentTypes table
   (Rust endpoints), and the positional-enumeration exception from
   Kernel/CompletionData.wl. *)

root = Directory[];
fail[msg_] := (Print["generate-completions: ", msg]; Quit[1]);

typesFile = FileNameJoin[{root, "Kernel", "ArgumentTypes.wl"}];
dataFile = FileNameJoin[{root, "Kernel", "CompletionData.wl"}];
packageFile = FileNameJoin[{root, "Kernel", "Matheme.wl"}];

(* CI consumes a checked-in copy of this table instead of running a kernel.
   MATHEME_COMPLETIONS_OUT lets the local precompile step write it together
   with the source manifest under .github/pregenerated/. *)
outDir = If[StringQ[Environment["MATHEME_COMPLETIONS_OUT"]],
  Environment["MATHEME_COMPLETIONS_OUT"],
  FileNameJoin[{root, "output", "Matheme", "AutoCompletionData"}]];
outFile = FileNameJoin[{outDir, "specialArgFunctions.tr"}];

types = Block[{$argumentTypes}, Quiet[Check[Get[typesFile], $Failed]]; $argumentTypes];
If[!AssociationQ[types], fail["missing or invalid " <> typesFile]];
positionalActions = Block[{$positionalCompletionActions},
  Quiet[Check[Get[dataFile], $Failed]]; $positionalCompletionActions];
If[!ListQ[positionalActions], fail["missing or invalid " <> dataFile]];

Quiet[Check[Get[packageFile], fail["could not load " <> packageFile]]];
displayNames = Runge`Matheme`Private`$displayNames;
reverseNames = AssociationThread[Values[displayNames] -> Keys[displayNames]];
shortName[full_] := StringReplace[full, "Runge`Matheme`" -> ""];

includedQ[full_] := Module[{fn = ToExpression[full], action},
  If[Options[fn] =!= {}, Return[True]];
  action = Lookup[reverseNames, shortName[full], None];
  action =!= None && KeyExistsQ[types, action] && types[action] =!= <||>
];

(* enumOption[{"all", ...}] -> {"Fonts", ..., "All"}, matching the public
   capitalised spelling of ClearMathemeCache targets. *)
enumValues[pattern_] := RotateLeft @ DeleteDuplicates @ StringCases[
  ToString[pattern, InputForm],
  "\"" ~~ Shortest[s___] ~~ "\"" :> ToUpperCase[StringTake[s, 1]] <> StringDrop[s, 1]
];

specFor[full_] := Module[{fn = ToExpression[full], name = shortName[full],
                          action, pattern, specs, argPattern},
  action = Lookup[reverseNames, name, None];
  Which[
    MemberQ[positionalActions, action],
      pattern = First[types[action]];
      {list[enumValues[pattern]]},
    Options[fn] =!= {},
      specs = {list[First /@ Options[fn]]};
      argPattern = "ArgumentsPattern" /. SyntaxInformation[fn];
      If[argPattern =!= {} && !MatchQ[First[argPattern], _OptionsPattern],
        specs = Prepend[specs, 0]];
      specs,
    True,
      {list[Keys[types[action]]]}
  ]
];

quote[s_] := "\"" <> s <> "\"";
list[names_List] := "{" <> StringRiffle[quote /@ names, ", "] <> "}";
specText[s_] := If[StringQ[s], s, ToString[s, InputForm]];
ruleText[full_] := Module[{specs = specFor[full]},
  "  " <> quote[shortName[full]] <> " -> {\n    " <>
    StringRiffle[specText /@ specs, ",\n    "] <> "\n  }"
];

selected = Sort[Select[Names["Runge`Matheme`*"], includedQ]];
header = "(* Generated by scripts/generate-completions.wl during the paclet \
build. Do not edit.\n\n   Public function names come from the loaded \
Kernel/Matheme.wl,\n   option names from Options[f] or the generated \
Kernel/ArgumentTypes.wl, and\n   positional enumerations from \
Kernel/CompletionData.wl.\n\n   PacletInfo.m declares \
{\"AutoCompletionData\", Root -> \"AutoCompletionData\"},\n   so the FrontEnd \
merges this file into its specialArgFunctions table. Each entry is\n   \
\"FunctionName\" -> {argSpec1, ...}, with ONE specifier per argument \
position;\n   0 means no special completion. *)\n\n";

If[!DirectoryQ[outDir],
  CreateDirectory[outDir, CreateIntermediateDirectories -> True]];
stream = OpenWrite[outFile, BinaryFormat -> True];
WriteString[stream,
  header <> "{\n" <> StringRiffle[ruleText /@ selected, ",\n\n"] <> "\n}\n"];
Close[stream];
Print["Wrote ", outFile];

(* Fingerprint the inputs so CI can reject a stale checked-in table without
   ever starting a kernel. IntegerString gives the same lowercase hex digest
   as Nushell's `hash sha256`. *)
manifestFile = FileNameJoin[{outDir, "specialArgFunctions.manifest.json"}];
hash[file_] := IntegerString[FileHash[file, "SHA256"], 16, 64];
manifest = <|
  "generatedBy" -> "scripts/generate-completions.wl",
  "wolframVersion" -> $Version,
  "sources" -> <|
    "Kernel/ArgumentTypes.wl" -> hash[typesFile],
    "Kernel/CompletionData.wl" -> hash[dataFile],
    "Kernel/Matheme.wl" -> hash[packageFile]
  |>
|>;
Export[manifestFile, manifest, "JSON"];
Print["Wrote ", manifestFile];
