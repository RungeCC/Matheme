(* ::Package:: *)

(* Generate AutoCompletionData/specialArgFunctions.tr from the WL sources.

   Run from the workspace root via scripts/build.nu.  Nothing here is a
   second source of truth:

     - action -> public WL function name: $displayNames in Kernel/Core.wl
     - Rust-backed option names: $argumentTypes in Kernel/ArgumentTypes.wl
       (generated by matheme-option-schema from the wl_actions! schema)
     - Wolfram-only option names: option defaults in Kernel/Matheme.wl and
       Kernel/TypstForm/Config.wl

   Core.wl has load-time side effects, so its table is read from source text
   rather than Get'ed. *)

root = Directory[];
core = Import[FileNameJoin[{root, "Kernel", "Core.wl"}], "Text"];
typesFile = FileNameJoin[{root, "Kernel", "ArgumentTypes.wl"}];
matheme = Import[FileNameJoin[{root, "Kernel", "Matheme.wl"}], "Text"];
config = Import[FileNameJoin[{root, "Kernel", "TypstForm", "Config.wl"}], "Text"];
outFile = FileNameJoin[{root, "AutoCompletionData", "specialArgFunctions.tr"}];

fail[msg_] := (Print["generate-completions: ", msg]; Quit[1]);

(* Evaluate just one `name = value;` assignment from a source file. *)
readValue[text_, name_String] := Module[{pos, rest, endPos},
  pos = StringPosition[text, "$" <> name <> " = "];
  If[pos === {}, fail["missing assignment $" <> name]];
  rest = StringDrop[text, pos[[1, 2]]];
  endPos = StringPosition[rest, ";\n"];
  If[endPos === {}, endPos = StringPosition[rest, ";\r\n"]];
  If[endPos === {}, fail["unterminated assignment $" <> name]];
  ToExpression[StringTake[rest, endPos[[1, 1]] - 1]]
];

displayNames = readValue[core, "displayNames"];
argumentTypes = Block[{$argumentTypes}, Get[typesFile]; $argumentTypes];
compileOptions = Keys[readValue[matheme, "compileOptionDefaults"]];
boxOptions = Keys[readValue[config, "typstBoxOptionDefaults"]];
exprOptions = Block[{$typstBoxOptionDefaults = readValue[config, "typstBoxOptionDefaults"]},
  Keys[readValue[config, "typstExprOptionDefaults"]]];

(* ClearMathemeCache takes one positional target, not an option; the legal
   values are the enum names in the generated "Targets" pattern. *)
targetPattern = ToString[argumentTypes["clearCache"]["Targets"], InputForm];
targetNames = StringCases[targetPattern,
  "\"" ~~ Shortest[s___] ~~ "\"" :> ToUpperCase[StringTake[s, 1]] <> StringDrop[s, 1]];
cacheTargets = RotateLeft[DeleteDuplicates[targetNames]];

quote[s_] := "\"" <> s <> "\"";
list[names_List] := "{" <> StringRiffle[quote /@ names, ", "] <> "}";
specialRule[name_String, specs_List] :=
  "  " <> quote[name] <> " -> {\n" <>
    StringRiffle[("    " <> #) & /@ specs, ",\n"] <> "\n  }";

reverseNames = AssociationThread[Values[displayNames] -> Keys[displayNames]];
keysOf[action_] := If[KeyExistsQ[argumentTypes, action], Keys[argumentTypes[action]], {}];

specFor["MathemeCompile"] = {"0", list[compileOptions]};
specFor["MathemeToGraphics"] = {"0", list[compileOptions]};
specFor["TypstForm"] = {"0", list[exprOptions]};
specFor["MathemeToTypst"] = {"0", list[exprOptions]};
specFor["BoxesToTypst"] = {"0", list[boxOptions]};
specFor["ClearMathemeCache"] = {list[cacheTargets]};
specFor[name_] := {list[keysOf[reverseNames[name]]]};

functions = {
  "MathemeCompile", "MathemeToGraphics", "TypstForm", "MathemeToTypst",
  "BoxesToTypst", "MathemeWarmup", "SetMatheme", "MathemeQueryFonts",
  "MathemeQueryPackages", "ClearMathemeCache"
};

header = "(* Generated by scripts/generate-completions.wl during the paclet \
build. Do not edit.\n\n   Action-to-function names come from Kernel/Core.wl \
($displayNames), option names\n   from the generated Kernel/ArgumentTypes.wl \
and the Wolfram-only option defaults.\n\n   PacletInfo.m declares \
{\"AutoCompletionData\", Root -> \"AutoCompletionData\"},\n   so the FrontEnd \
merges this file into its specialArgFunctions table. Each entry is\n   \
\"FunctionName\" -> {argSpec1, ...}, with ONE specifier per argument \
position;\n   0 means no special completion. *)\n\n";

If[!DirectoryQ[DirectoryName[outFile]],
  CreateDirectory[DirectoryName[outFile], CreateIntermediateDirectories -> True]];
stream = OpenWrite[outFile, BinaryFormat -> True];
WriteString[stream,
  header <> "{\n" <> StringRiffle[specialRule[#, specFor[#]] & /@ functions, ",\n\n"] <> "\n}\n"];
Close[stream];
Print["Wrote ", outFile];
