#!/usr/bin/env bash
set -euo pipefail

staged_rust_files() {
    git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs'
}

staged_rust_files | while IFS= read -r -d '' path; do
    if ! git --literal-pathspecs diff --quiet -- "$path"; then
        printf 'Partially staged Rust file: %s\n' "$path" >&2
        printf 'Resolve its staged and unstaged edits before formatting the commit.\n' >&2
        exit 1
    fi
done

cargo fmt --all

staged_rust_files | while IFS= read -r -d '' path; do
    git --literal-pathspecs add -- "$path"
done

cargo clippy --workspace --all-targets --all-features
